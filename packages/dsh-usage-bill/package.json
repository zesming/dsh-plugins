{
  "name": "dsh-usage-bill",
  "version": "0.1.0",
  "description": "DeepSeek balance and a token-usage heatmap in DeepSeek Harness",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token-usage",
    "usage",
    "balance",
    "heatmap",
    "cost"
  ],
  "license": "MIT",
  "author": "zesming",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zesming/dsh-plugins.git",
    "directory": "packages/dsh-usage-bill"
  },
  "homepage": "https://github.com/zesming/dsh-plugins/tree/main/packages/dsh-usage-bill#readme",
  "bugs": {
    "url": "https://github.com/zesming/dsh-plugins/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
